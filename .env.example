# ==========================================================
# CyberSahay V2 - Environment Configuration
# ==========================================================

# 1. Environment & API Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# 2. LLM Provider (Groq API)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
MAX_TOKENS=1024

# 3. Database
# Defaults to local SQLite file cybersahay.db
DATABASE_URL=sqlite:///./cybersahay.db

# 4. Authentication & Security
# In production, must be at least 32 characters long
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,*

# 6. Hybrid RAG & Knowledge Base Paths
CHROMA_PERSIST_DIR=./chroma_db
BM25_PERSIST_DIR=./bm25_index.pkl
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# 7. Document & Evidence Processing
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=20